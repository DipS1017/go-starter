                  "$ref": "#/components/schemas/dto.CodeExchangeRequest"
                }
              }
            },
            "description": "Successfully logged in"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorhandler.HttpError"
                }
              }
