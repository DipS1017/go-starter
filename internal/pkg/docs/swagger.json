        "new_password"
      ],
      "properties": {
        "current_password": {
          "type": "string"
        },
        "new_password": {
          "type": "string"
        }
      }
    },
    "dto.ProfileImageUploadResponse": {
      "type": "object",
      "properties": {
        "profile_image": {
          "type": "string"
        }
      }
    },
    "dto.RefreshTokenResponse": {
      "type": "object",
      "properties": {
        "access_token": {
          "type": "string"
        }
      }
    },
    "dto.ResendEmailVerificationRequest": {
      "type": "object",
      "required": [
        "email"
      ],
      "properties": {
        "email": {
          "type": "string"
        }
      }
    },
    "dto.SuccessMessageResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        }
      }
    },
    "dto.UserInfoResponse": {
      "type": "object",
      "properties": {
        "apple_id": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "google_id": {
          "type": "string"
        },
        "has_password": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "is_email_verified": {
          "type": "boolean"
        },
        "is_privacy_policy_accepted": {
          "type": "boolean"
        },
        "is_profile_complete": {
          "type": "boolean"
        },
        "is_regulation_accepted": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "phone_number": {
          "type": "string"
        },
        "profession": {
          "type": "string"
        },
        "profile_image": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "username": {
          "type": "string"
        }
      }
    },
    "errorhandler.HttpError": {
      "description": "This error is returned for specific failures within the API",
      "type": "object",
      "properties": {
        "caller": {
          "type": "string"
        },
        "code": {
          "type": "integer"
        },
        "message": {}
      }
    }
  },
  "securityDefinitions": {
    "ApiKeyAuth": {
      "description": "Enter your API key in the format: x-api-key",
      "type": "apiKey",
      "name": "x-api-key",
      "in": "header"
    },
    "BearerAuth": {
      "description": "Enter your JWT token in the format: Bearer <token>",
      "type": "apiKey",
      "name": "Authorization",
      "in": "header"
    }
  }
}
