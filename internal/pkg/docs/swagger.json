{
  "components": {
    "schemas": {
      "dto.CodeExchangeRequest": {
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "dto.EmailLoginRequest": {
        "properties": {
          "email": {
            "type": "string"
          },
          "is_admin": {
            "type": "boolean"
          },
          "password": {
            "minLength": 8,
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "dto.EmailSignUpRequest": {
        "properties": {
          "email": {
            "type": "string"
          },
          "is_regulation_accepted": {
            "type": "boolean"
          },
          "name": {
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "password": {
            "minLength": 8,
            "type": "string"
          },
          "phone_number": {
            "type": "string"
          },
          "privacy_policy": {
            "type": "boolean"
          }
        },
        "required": [
          "email",
          "is_regulation_accepted",
          "name",
          "password",
          "privacy_policy"
        ],
        "type": "object"
      },
      "dto.LoginResponse": {
        "properties": {
          "access_token": {
            "type": "string"
          },
          "is_admin": {
            "type": "boolean"
          },
          "is_first_login": {
            "type": "boolean"
          },
          "refresh_token": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "dto.MediaUploadForm": {
        "properties": {
          "file": {
            "form": "file",
            "format": "binary",
            "type": "string"
          },
          "isPublic": {
            "example": false,
            "form": "isPublic",
            "type": "boolean"
          },
          "thumbnail": {
            "form": "thumbnail",
            "format": "binary",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "type": "object"
      },
      "dto.MediaUploadResponse": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "dto.PasswordResetConfirmRequest": {
        "properties": {
          "password": {
            "minLength": 8,
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "type": "object"
      },
      "dto.PasswordResetRequest": {
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "dto.PasswordResetTokenCheck": {
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      },
      "dto.PasswordUpdateRequest": {
        "properties": {
          "current_password": {
            "type": "string"
          },
          "new_password": {
            "type": "string"
          }
        },
        "required": [
          "new_password"
        ],
        "type": "object"
      },
      "dto.ProfileImageUploadForm": {
        "properties": {
          "image": {
            "form": "image",
            "format": "binary",
            "type": "string"
          }
        },
        "required": [
          "image"
        ],
        "type": "object"
      },
      "dto.ProfileImageUploadResponse": {
        "properties": {
          "profile_image": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "dto.RefreshTokenResponse": {
        "properties": {
          "access_token": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "dto.ResendEmailVerificationRequest": {
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "dto.SuccessMessageResponse": {
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "dto.UserInfoResponse": {
        "properties": {
          "apple_id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "google_id": {
            "type": "string"
          },
          "has_password": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "is_email_verified": {
            "type": "boolean"
          },
          "is_privacy_policy_accepted": {
            "type": "boolean"
          },
          "is_profile_complete": {
            "type": "boolean"
          },
          "is_regulation_accepted": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "phone_number": {
            "type": "string"
          },
          "profession": {
            "type": "string"
          },
          "profile_image": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "errorhandler.HttpError": {
        "description": "This error is returned for specific failures within the API",
        "properties": {
          "caller": {
            "type": "string"
          },
          "code": {
            "type": "integer"
          },
          "message": {}
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "description": "Enter your API key in the format: x-api-key",
        "in": "header",
        "name": "x-api-key",
        "type": "apiKey"
      },
      "BearerAuth": {
        "description": "Enter your JWT token in the format: Bearer <token>",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
