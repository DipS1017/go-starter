  "definitions": {
    "dto.CodeExchangeRequest": {
      "type": "object",
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string"
        }
      }
    },
    "dto.EmailLoginRequest": {
      "type": "object",
      "required": [
        "email",
        "password"
      ],
      "properties": {
        "email": {
          "type": "string"
        },
        "is_admin": {
          "type": "boolean"
        },
        "password": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "dto.EmailSignUpRequest": {
      "type": "object",
      "required": [
        "email",
        "is_regulation_accepted",
        "name",
        "password",
        "privacy_policy"
      ],
      "properties": {
        "email": {
          "type": "string"
        },
        "is_regulation_accepted": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "minLength": 2
        },
        "password": {
          "type": "string",
          "minLength": 8
        },
        "phone_number": {
          "type": "string"
        },
        "privacy_policy": {
          "type": "boolean"
        }
      }
    },
    "dto.LoginResponse": {
      "type": "object",
      "properties": {
        "access_token": {
          "type": "string"
        },
        "is_admin": {
          "type": "boolean"
        },
        "is_first_login": {
          "type": "boolean"
        },
        "refresh_token": {
          "type": "string"
        }
      }
    },
    "dto.MediaUploadResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "dto.PasswordResetConfirmRequest": {
      "type": "object",
      "required": [
        "password"
      ],
      "properties": {
        "password": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "dto.PasswordResetRequest": {
      "type": "object",
      "required": [
        "email"
      ],
      "properties": {
        "email": {
          "type": "string"
        }
      }
    },
    "dto.PasswordResetTokenCheck": {
      "type": "object",
